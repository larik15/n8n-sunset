        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"gemini-2.0-flash\"}"
      },
      "id": "4",
      "name": "Vertex AI endpoint",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [600, 0]
    },
    {
