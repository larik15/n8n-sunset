{
  "id": "wf-gemini-http",
  "name": "Gemini REST calls",
  "nodes": [
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=PLACEHOLDER",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"contents\": [{\"parts\": [{\"text\": \"Hello\"}]}]}"
      },
      "id": "1",
      "name": "generateContent (model in the URL)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0]
