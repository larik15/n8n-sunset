    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"model\": \"gemini-2.0-flash-lite\", \"messages\": [{\"role\": \"user\", \"content\": \"Hi\"}]}"
      },
      "id": "2",
      "name": "OpenAI-compatible endpoint (model in the body)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/text-embedding-004:batchEmbedContents",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"requests\": [{\"model\": \"models/text-embedding-004\", \"content\": {\"parts\": [{\"text\": \"a\"}]}}]}"
      },
      "id": "3",
      "name": "Same model in URL and body",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [400, 0]
    },
    {
      "parameters": {
        "method": "POST",
